# Startup file for bash nvim - goes in the user home directory
###########################################################################
# NEOVIM CONFIG

# | Dir | Key | Run | GoCfg| Purpose                            |
# |-----|-----|-----|------|------------------------------------|
# | PRO | p   | nv  | gnc  | Production                         |
# | ast | a   | nva | gnca | Astrovim - https://astronvim.com   |
# | lzy | l   | nvl | gncl | Lazyvim  - https://www.lazyvim.org |

###########################################################################
# VARIABLES

export NV_BASE_CONF="~/.config/nvim"

export NV_PRO=PRO
export NV_AST=ast
export NV_DEV=dev
export NV_LZY=lzy

###########################################################################
# RUN

pwd_short() {
  pwd | sed "s|$HOME|~|"
}

nvrun() {
  if [ $# -eq 0 ]; then
    xterm_title "$(ssh_htag)$NV_CMD $(pwd_short)/"
  else
    xterm_title "$(ssh_htag)$NV_CMD $@"
  fi
  TERM=xterm-256color NVIM_APPNAME=$NV_APP nvim $@
}

alias  nv="NV_CMD=nv  NV_APP=edit/$NV_PRO nvrun"
alias nva="NV_CMD=nva NV_APP=edit/$NV_ALT nvrun"
alias nvd="NV_CMD=nvd NV_APP=edit/$NV_DEV nvrun"
alias nvl="NV_CMD=nvl NV_APP=edit/$NV_LZY nvrun"

# See also: nvw, catw, nvp, catp, prompt_which in ~/.bashrc_code

alias nv_ide="IDE_MODE=true nv" 

# See also: claude_ide

###########################################################################
# CLIENT / SERVER 

export NVIM_SERVER_PIPE=/tmp/nvim-server-pipe
export NVIM_SERVER_CWD=/tmp/nvim-server-cwd

nvserver() {
    local server_pipe="$NVIM_SERVER_PIPE"
    local server_cwd="$NVIM_SERVER_CWD"

    # Kill any existing nvim server using this pipe (if any)
    if nvim --server "$server_pipe" --remote-send '<C-\><C-n>:qall<CR>' 2>/dev/null; then
        echo "Closed previous nvim server gracefully"
        sleep 0.2   # give it a moment to release the pipe
    fi

    # Force-remove the pipe file if it still exists (stale socket)
    rm -f "$server_pipe" "$server_cwd"

    # Start fresh headless server in the background
    pwd > "$server_cwd"
    local LPWD=$(printf %q "$PWD")
    nvim --headless --listen "$pipe" -c "cd $LPWD" &>/dev/null &
    disown

    echo "New shared nvim server started → $pipe"
    echo "CWD: $PWD"
    echo "Connect with: nvclient"
}

nvclient() { 
  test -f "$NVIM_SERVER_CWD" && cd "$(cat "$NVIM_SERVER_CWD")";
  nv --server $NVIM_SERVER_PIPE
}

###########################################################################
# GOTO

alias   gun="pushdp ~/util/edit_util"
alias  gunc="pushdp ~/util/edit_util/cfg"
alias  gunb="pushdp ~/util/edit_util/bin"

alias  gnc="pushdp $NV_BASE_CONF/$NV_PRO"
alias gnca="pushdp $NV_BASE_CONF/$NV_AST"
alias gncd="pushdp $NV_BASE_CONF/$NV_DEV"
alias gncl="pushdp $NV_BASE_CONF/$NV_LZY"

