{
  "x-sh": {
    "prefix": "x-sh",
    "body": [
      "#!/bin/sh"
    ],
    "description": "Shebang line"
  },
  "x-s#!": {
    "prefix": "x-s#!",
    "body": [
      "#!/bin/sh",
      "set -eu"
    ],
    "description": "Shebang line"
  },
  "x-safe": {
    "prefix": "x-safe",
    "body": [
      "set -eu"
    ]
  },
  "x-bash": {
    "prefix": "x-bash",
    "body": [
      "#!/usr/bin/env bash"
    ]
  },
  "x-sbash": {
    "prefix": "x-sbash",
    "body": [
      "#!/usr/bin/env bash",
      "set -euo pipefail",
      "IFS=$'\\n\\t'"
    ]
  },
  "x-if": {
    "prefix": "x-if",
    "body": [
      "if [ $1 ]; then",
      "\t${0:${VISUAL}}",
      "fi"
    ]
  },
  "x-elif": {
    "prefix": "x-elif",
    "body": [
      "elif [ $1 ]; then",
      "\t${0:${VISUAL}}"
    ]
  },
  "x-for": {
    "prefix": "x-for",
    "body": [
      "for (( ${2:i} = 0; $2 < ${1:count}; $2++ )); do",
      "\t${0:${VISUAL}}",
      "done"
    ]
  },
  "x-fori": {
    "prefix": "x-fori",
    "body": [
      "for ${1:needle} in ${2:haystack} ; do",
      "\t${0:${VISUAL}}",
      "done"
    ]
  },
  "x-wh": {
    "prefix": "x-wh",
    "body": [
      "while [ $1 ]; do",
      "\t${0:${VISUAL}}",
      "done"
    ]
  },
  "x-wht": {
    "prefix": "x-wht",
    "body": [
      "while true; do",
      "\t${0:${VISUAL}}",
      "done"
    ]
  },
  "x-until": {
    "prefix": "x-until",
    "body": [
      "until [ $1 ]; do",
      "\t${0:${VISUAL}}",
      "done"
    ]
  },
  "x-case": {
    "prefix": "x-case",
    "body": [
      "case ${1:word} in",
      "\t${2:pattern})",
      "\t\t${0};;",
      "esac"
    ]
  },
  "x-go": {
    "prefix": "x-go",
    "body": [
      "while getopts '${1:o}' ${2:opts}",
      "do",
      "\tcase $$2 in",
      "\t${3:o0})",
      "\t\t${0:#staments};;",
      "\tesac",
      "done"
    ]
  },
  "x-sdir": {
    "prefix": "x-sdir",
    "body": [
      "SCRIPT_DIR=\"\\$( cd \"\\$( dirname \"\\${BASH_SOURCE[0]}\" )\" && pwd )\""
    ]
  },
  "x-getopt": {
    "prefix": "x-getopt",
    "body": [
      "__ScriptVersion=\"${1:version}\"",
      "#===  FUNCTION  ================================================================",
      "#         NAME:  usage",
      "#  DESCRIPTION:  Display usage information.",
      "#===============================================================================",
      "function usage ()",
      "{",
      "\techo \"Usage :  \\$${0:0} [options] [--]",
      "    Options:",
      "    -h|help       Display this message",
      "    -v|version    Display script version\"",
      "}    # ----------  end of function usage  ----------",
      "#-----------------------------------------------------------------------",
      "#  Handle command line arguments",
      "#-----------------------------------------------------------------------",
      "while getopts \":hv\" opt",
      "do",
      "  case \\$opt in",
      "\th|help     )  usage; exit 0   ;;",
      "\tv|version  )  echo \"\\$${0:0} -- Version \\$__ScriptVersion\"; exit 0   ;;",
      "\t* )  echo -e \"\\\\n  Option does not exist : \\$OPTARG\\\\n\"",
      "\t\t  usage; exit 1   ;;",
      "  esac    # --- end of case ---",
      "done",
      "shift \\$(($OPTIND-1))"
    ]
  },
  "x-root": {
    "prefix": "x-root",
    "body": [
      "if [ \\$(id -u) -ne 0 ]; then exec sudo \\$0; fi"
    ]
  },
  "x-fun-sh": {
    "prefix": "x-fun-sh",
    "body": [
      "${1:function_name}() {",
      "\t$0",
      "}"
    ]
  },
  "x-fun": {
    "prefix": "x-fun",
    "body": [
      "function ${1:function_name}() {",
      "\t$0",
      "}"
    ]
  }
}
