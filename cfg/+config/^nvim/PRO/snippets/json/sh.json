{
  "xsh": {
    "prefix": "xsh",
    "body": [
      "#!/bin/sh"
    ],
    "description": "Shebang line"
  },
  "xs#!": {
    "prefix": "xs#!",
    "body": [
      "#!/bin/sh",
      "set -eu"
    ],
    "description": "Shebang line"
  },
  "xsafe": {
    "prefix": "xsafe",
    "body": [
      "set -eu"
    ]
  },
  "xbash": {
    "prefix": "xbash",
    "body": [
      "#!/usr/bin/env bash"
    ]
  },
  "xsbash": {
    "prefix": "xsbash",
    "body": [
      "#!/usr/bin/env bash",
      "set -euo pipefail",
      "IFS=$'\\n\\t'"
    ]
  },
  "xif": {
    "prefix": "xif",
    "body": [
      "if [ $1 ]; then",
      "\t${0:${VISUAL}}",
      "fi"
    ]
  },
  "xelif": {
    "prefix": "xelif",
    "body": [
      "elif [ $1 ]; then",
      "\t${0:${VISUAL}}"
    ]
  },
  "xfor": {
    "prefix": "xfor",
    "body": [
      "for (( ${2:i} = 0; $2 < ${1:count}; $2++ )); do",
      "\t${0:${VISUAL}}",
      "done"
    ]
  },
  "xfori": {
    "prefix": "xfori",
    "body": [
      "for ${1:needle} in ${2:haystack} ; do",
      "\t${0:${VISUAL}}",
      "done"
    ]
  },
  "xwh": {
    "prefix": "xwh",
    "body": [
      "while [ $1 ]; do",
      "\t${0:${VISUAL}}",
      "done"
    ]
  },
  "xwht": {
    "prefix": "xwht",
    "body": [
      "while true; do",
      "\t${0:${VISUAL}}",
      "done"
    ]
  },
  "xuntil": {
    "prefix": "xuntil",
    "body": [
      "until [ $1 ]; do",
      "\t${0:${VISUAL}}",
      "done"
    ]
  },
  "xcase": {
    "prefix": "xcase",
    "body": [
      "case ${1:word} in",
      "\t${2:pattern})",
      "\t\t${0};;",
      "esac"
    ]
  },
  "xgo": {
    "prefix": "xgo",
    "body": [
      "while getopts '${1:o}' ${2:opts}",
      "do",
      "\tcase $$2 in",
      "\t${3:o0})",
      "\t\t${0:#staments};;",
      "\tesac",
      "done"
    ]
  },
  "xsdir": {
    "prefix": "xsdir",
    "body": [
      "SCRIPT_DIR=\"\\$( cd \"\\$( dirname \"\\${BASH_SOURCE[0]}\" )\" && pwd )\""
    ]
  },
  "xgetopt": {
    "prefix": "xgetopt",
    "body": [
      "__ScriptVersion=\"${1:version}\"",
      "#===  FUNCTION  ================================================================",
      "#         NAME:  usage",
      "#  DESCRIPTION:  Display usage information.",
      "#===============================================================================",
      "function usage ()",
      "{",
      "\techo \"Usage :  \\$${0:0} [options] [--]",
      "    Options:",
      "    -h|help       Display this message",
      "    -v|version    Display script version\"",
      "}    # ----------  end of function usage  ----------",
      "#-----------------------------------------------------------------------",
      "#  Handle command line arguments",
      "#-----------------------------------------------------------------------",
      "while getopts \":hv\" opt",
      "do",
      "  case \\$opt in",
      "\th|help     )  usage; exit 0   ;;",
      "\tv|version  )  echo \"\\$${0:0} -- Version \\$__ScriptVersion\"; exit 0   ;;",
      "\t* )  echo -e \"\\\\n  Option does not exist : \\$OPTARG\\\\n\"",
      "\t\t  usage; exit 1   ;;",
      "  esac    # --- end of case ---",
      "done",
      "shift \\$(($OPTIND-1))"
    ]
  },
  "xroot": {
    "prefix": "xroot",
    "body": [
      "if [ \\$(id -u) -ne 0 ]; then exec sudo \\$0; fi"
    ]
  },
  "xfun-sh": {
    "prefix": "xfun-sh",
    "body": [
      "${1:function_name}() {",
      "\t$0",
      "}"
    ]
  },
  "xfun": {
    "prefix": "xfun",
    "body": [
      "function ${1:function_name}() {",
      "\t$0",
      "}"
    ]
  }
}
