{
  "x%": {
    "prefix": "x%",
    "body": [
      "<% ${0} %>"
    ],
    "description": "<% %>"
  },
  "x=": {
    "prefix": "x=",
    "body": [
      "<%= ${0} %>"
    ],
    "description": "<%= %>"
  },
  "xend": {
    "prefix": "xend",
    "body": [
      "<% end %>"
    ]
  },
  "xfor": {
    "prefix": "xfor",
    "body": [
      "<%= for ${1:item} <- ${2:items} ${3:@conn} do %>",
      "  ${0}",
      "<% end %>"
    ],
    "description": "for loop"
  },
  "xif": {
    "prefix": "xif",
    "body": [
      "<%= if ${1} do %>",
      "  ${0:${VISUAL}}",
      "<% end %>"
    ],
    "description": "if statement"
  },
  "xife": {
    "prefix": "xife",
    "body": [
      "<%= if ${1} do %>",
      "  ${2:${VISUAL}}",
      "<% else %>",
      "  ${0}",
      "<% end %>"
    ],
    "description": "if/else statement"
  },
  "xcond": {
    "prefix": "xcond",
    "body": [
      "<%= cond do %>",
      "  <% ${1} -> %>",
      "    ${2:${VISUAL}}",
      "  <% true -> %>",
      "  ${0}",
      "<% end %>"
    ]
  },
  "xunless": {
    "prefix": "xunless",
    "body": [
      "<%= unless ${1} do %>",
      "  ${0:${VISUAL}}",
      "<% end %>"
    ]
  },
  "xft": {
    "prefix": "xft",
    "body": [
      "<%= form_tag(${1:\"/users\"}, method: ${2::post}) %>",
      "  ${0}",
      "</form>"
    ],
    "description": "form_tag"
  },
  "xsl": {
    "prefix": "xsl",
    "body": [
      "<%= select ${1:f}, :${2:field}, ${3:[{\"key\", \"value\"}]}, prompt: ${4:\"Prompt\"} %>"
    ],
    "description": "select"
  },
  "xsb": {
    "prefix": "xsb",
    "body": [
      "<%= submit ${1:\"Submit\"} %>"
    ],
    "description": "submit"
  },
  "xrb": {
    "prefix": "xrb",
    "body": [
      "<%= radio_button ${1:f}, :${2:field},  ${3:\"value\"} %>"
    ],
    "description": "radio_button"
  },
  "xet": {
    "prefix": "xet",
    "body": [
      "<%= error_tag ${1:f}, :${2:field} %>"
    ],
    "description": "error_tag"
  },
  "xti": {
    "prefix": "xti",
    "body": [
      "<%= text_input ${1:f}, :${2:field} %>"
    ],
    "description": "text_input"
  },
  "xla": {
    "prefix": "xla",
    "body": [
      "<%= label ${1:f}, :${2:field}, \"${3:Label}\" %>"
    ],
    "description": "label"
  },
  "xpi": {
    "prefix": "xpi",
    "body": [
      "<%= password_input ${1:f}, :${2:password} %>"
    ],
    "description": "password_input"
  },
  "xrender": {
    "prefix": "xrender",
    "body": [
      "<%= render \"${1:index}.html\", ${2:var: @var} %>"
    ]
  },
  "xlin": {
    "prefix": "xlin",
    "body": [
      "<%= link \"${1:Submit}\", to: ${2:\"/users\"}, method: ${3::delete} %>"
    ],
    "description": "link"
  },
  "xff": {
    "prefix": "xff",
    "body": [
      "<%= form_for @changeset, ${1:\"/users\"}, fn f -> %>",
      "    ${0}",
      "  <%= submit \"Submit\" %>",
      "<% end %>"
    ],
    "description": "form_for"
  },
  "xpry": {
    "prefix": "xpry",
    "body": [
      "<% require IEx; IEx.pry %>"
    ]
  }
}
