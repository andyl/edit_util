{
  "x-%": {
    "prefix": "x-%",
    "body": [
      "<% ${0} %>"
    ],
    "description": "<% %>"
  },
  "x-=": {
    "prefix": "x-=",
    "body": [
      "<%= ${0} %>"
    ],
    "description": "<%= %>"
  },
  "x-end": {
    "prefix": "x-end",
    "body": [
      "<% end %>"
    ]
  },
  "x-for": {
    "prefix": "x-for",
    "body": [
      "<%= for ${1:item} <- ${2:items} ${3:@conn} do %>",
      "  ${0}",
      "<% end %>"
    ],
    "description": "for loop"
  },
  "x-if": {
    "prefix": "x-if",
    "body": [
      "<%= if ${1} do %>",
      "  ${0:${VISUAL}}",
      "<% end %>"
    ],
    "description": "if statement"
  },
  "x-ife": {
    "prefix": "x-ife",
    "body": [
      "<%= if ${1} do %>",
      "  ${2:${VISUAL}}",
      "<% else %>",
      "  ${0}",
      "<% end %>"
    ],
    "description": "if/else statement"
  },
  "x-cond": {
    "prefix": "x-cond",
    "body": [
      "<%= cond do %>",
      "  <% ${1} -> %>",
      "    ${2:${VISUAL}}",
      "  <% true -> %>",
      "  ${0}",
      "<% end %>"
    ]
  },
  "x-unless": {
    "prefix": "x-unless",
    "body": [
      "<%= unless ${1} do %>",
      "  ${0:${VISUAL}}",
      "<% end %>"
    ]
  },
  "x-ft": {
    "prefix": "x-ft",
    "body": [
      "<%= form_tag(${1:\"/users\"}, method: ${2::post}) %>",
      "  ${0}",
      "</form>"
    ],
    "description": "form_tag"
  },
  "x-sl": {
    "prefix": "x-sl",
    "body": [
      "<%= select ${1:f}, :${2:field}, ${3:[{\"key\", \"value\"}]}, prompt: ${4:\"Prompt\"} %>"
    ],
    "description": "select"
  },
  "x-sb": {
    "prefix": "x-sb",
    "body": [
      "<%= submit ${1:\"Submit\"} %>"
    ],
    "description": "submit"
  },
  "x-rb": {
    "prefix": "x-rb",
    "body": [
      "<%= radio_button ${1:f}, :${2:field},  ${3:\"value\"} %>"
    ],
    "description": "radio_button"
  },
  "x-et": {
    "prefix": "x-et",
    "body": [
      "<%= error_tag ${1:f}, :${2:field} %>"
    ],
    "description": "error_tag"
  },
  "x-ti": {
    "prefix": "x-ti",
    "body": [
      "<%= text_input ${1:f}, :${2:field} %>"
    ],
    "description": "text_input"
  },
  "x-la": {
    "prefix": "x-la",
    "body": [
      "<%= label ${1:f}, :${2:field}, \"${3:Label}\" %>"
    ],
    "description": "label"
  },
  "x-pi": {
    "prefix": "x-pi",
    "body": [
      "<%= password_input ${1:f}, :${2:password} %>"
    ],
    "description": "password_input"
  },
  "x-render": {
    "prefix": "x-render",
    "body": [
      "<%= render \"${1:index}.html\", ${2:var: @var} %>"
    ]
  },
  "x-lin": {
    "prefix": "x-lin",
    "body": [
      "<%= link \"${1:Submit}\", to: ${2:\"/users\"}, method: ${3::delete} %>"
    ],
    "description": "link"
  },
  "x-ff": {
    "prefix": "x-ff",
    "body": [
      "<%= form_for @changeset, ${1:\"/users\"}, fn f -> %>",
      "    ${0}",
      "  <%= submit \"Submit\" %>",
      "<% end %>"
    ],
    "description": "form_for"
  },
  "x-pry": {
    "prefix": "x-pry",
    "body": [
      "<% require IEx; IEx.pry %>"
    ]
  }
}
