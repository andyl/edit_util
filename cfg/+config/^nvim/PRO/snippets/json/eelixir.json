{
  "%": {
    "prefix": "%",
    "body": [
      "<% ${0} %>"
    ],
    "description": "<% %>"
  },
  "=": {
    "prefix": "=",
    "body": [
      "<%= ${0} %>"
    ],
    "description": "<%= %>"
  },
  "end": {
    "prefix": "end",
    "body": [
      "<% end %>"
    ]
  },
  "for": {
    "prefix": "for",
    "body": [
      "<%= for ${1:item} <- ${2:items} ${3:@conn} do %>",
      "  ${0}",
      "<% end %>"
    ],
    "description": "for loop"
  },
  "if": {
    "prefix": "if",
    "body": [
      "<%= if ${1} do %>",
      "  ${0:${VISUAL}}",
      "<% end %>"
    ],
    "description": "if statement"
  },
  "ife": {
    "prefix": "ife",
    "body": [
      "<%= if ${1} do %>",
      "  ${2:${VISUAL}}",
      "<% else %>",
      "  ${0}",
      "<% end %>"
    ],
    "description": "if/else statement"
  },
  "cond": {
    "prefix": "cond",
    "body": [
      "<%= cond do %>",
      "  <% ${1} -> %>",
      "    ${2:${VISUAL}}",
      "  <% true -> %>",
      "  ${0}",
      "<% end %>"
    ]
  },
  "unless": {
    "prefix": "unless",
    "body": [
      "<%= unless ${1} do %>",
      "  ${0:${VISUAL}}",
      "<% end %>"
    ]
  },
  "ft": {
    "prefix": "ft",
    "body": [
      "<%= form_tag(${1:\"/users\"}, method: ${2::post}) %>",
      "  ${0}",
      "</form>"
    ],
    "description": "form_tag"
  },
  "sl": {
    "prefix": "sl",
    "body": [
      "<%= select ${1:f}, :${2:field}, ${3:[{\"key\", \"value\"}]}, prompt: ${4:\"Prompt\"} %>"
    ],
    "description": "select"
  },
  "sb": {
    "prefix": "sb",
    "body": [
      "<%= submit ${1:\"Submit\"} %>"
    ],
    "description": "submit"
  },
  "rb": {
    "prefix": "rb",
    "body": [
      "<%= radio_button ${1:f}, :${2:field},  ${3:\"value\"} %>"
    ],
    "description": "radio_button"
  },
  "et": {
    "prefix": "et",
    "body": [
      "<%= error_tag ${1:f}, :${2:field} %>"
    ],
    "description": "error_tag"
  },
  "ti": {
    "prefix": "ti",
    "body": [
      "<%= text_input ${1:f}, :${2:field} %>"
    ],
    "description": "text_input"
  },
  "la": {
    "prefix": "la",
    "body": [
      "<%= label ${1:f}, :${2:field}, \"${3:Label}\" %>"
    ],
    "description": "label"
  },
  "pi": {
    "prefix": "pi",
    "body": [
      "<%= password_input ${1:f}, :${2:password} %>"
    ],
    "description": "password_input"
  },
  "render": {
    "prefix": "render",
    "body": [
      "<%= render \"${1:index}.html\", ${2:var: @var} %>"
    ]
  },
  "lin": {
    "prefix": "lin",
    "body": [
      "<%= link \"${1:Submit}\", to: ${2:\"/users\"}, method: ${3::delete} %>"
    ],
    "description": "link"
  },
  "ff": {
    "prefix": "ff",
    "body": [
      "<%= form_for @changeset, ${1:\"/users\"}, fn f -> %>",
      "    ${0}",
      "  <%= submit \"Submit\" %>",
      "<% end %>"
    ],
    "description": "form_for"
  },
  "pry": {
    "prefix": "pry",
    "body": [
      "<% require IEx; IEx.pry %>"
    ]
  }
}
