{
  "x-local": {
    "prefix": "x-local",
    "body": [
      "local ${1:x} = ${0:1}"
    ]
  },
  "x-fun": {
    "prefix": "x-fun",
    "body": [
      "function ${1:fname}(${2:...})",
      "\t$0",
      "end"
    ]
  },
  "x-for": {
    "prefix": "x-for",
    "body": [
      "for ${1:i}=${2:1},${3:10} do",
      "\t${0:print(i)}",
      "end"
    ]
  },
  "x-forp": {
    "prefix": "x-forp",
    "body": [
      "for ${1:i},${2:v} in pairs(${3:table_name}) do",
      "\t$0",
      "end"
    ]
  },
  "x-fori": {
    "prefix": "x-fori",
    "body": [
      "for ${1:i},${2:v} in ipairs(${3:table_name}) do",
      "\t$0",
      "end"
    ]
  },
  "x-if": {
    "prefix": "x-if",
    "body": [
      "if $1 then",
      "\t$2",
      "end"
    ]
  },
  "x-ife": {
    "prefix": "x-ife",
    "body": [
      "if $1 then",
      "\t${2:-- if condition}",
      "else",
      "\t${0:-- else}",
      "end"
    ]
  },
  "x-elif": {
    "prefix": "x-elif",
    "body": [
      "elseif $1 then",
      "\t$0"
    ]
  },
  "x-repeat": {
    "prefix": "x-repeat",
    "body": [
      "repeat",
      "\t$1",
      "until $0"
    ]
  },
  "x-while": {
    "prefix": "x-while",
    "body": [
      "while $1 do",
      "\t$0",
      "end"
    ]
  },
  "x-wh": {
    "prefix": "x-wh",
    "body": [
      "while ${1:true} do",
      "\t${0}",
      "end"
    ]
  },
  "x-wht": {
    "prefix": "x-wht",
    "body": [
      "while true do",
      "\t${0}",
      "end"
    ]
  },
  "x-print": {
    "prefix": "x-print",
    "body": [
      "print(\"${1:string}\")"
    ]
  },
  "x-pr": {
    "prefix": "x-pr",
    "body": [
      "print($0)"
    ]
  },
  "x-prs": {
    "prefix": "x-prs",
    "body": [
      "print(\"$0\")"
    ]
  },
  "x-prf": {
    "prefix": "x-prf",
    "body": [
      "print(string.format(\"${1:%s}\"$0))"
    ]
  },
  "x-wr": {
    "prefix": "x-wr",
    "body": [
      "io.write($0)"
    ]
  },
  "x-wrs": {
    "prefix": "x-wrs",
    "body": [
      "io.write(\"$0\")"
    ]
  },
  "x-wrf": {
    "prefix": "x-wrf",
    "body": [
      "io.write(string.format(\"${1:%s}\"$0))"
    ]
  },
  "x-fwr": {
    "prefix": "x-fwr",
    "body": [
      "io.${1:stderr}:write($0)"
    ]
  },
  "x-fwrs": {
    "prefix": "x-fwrs",
    "body": [
      "io.${1:stderr}:write(\"$0\")"
    ]
  },
  "x-fwrf": {
    "prefix": "x-fwrf",
    "body": [
      "io.${1:stderr}:write(string.format(\"${2:%s}\"$0))"
    ]
  },
  "x-im": {
    "prefix": "x-im",
    "body": [
      "import \"${1:import file}\""
    ],
    "description": "Import File"
  }
}
