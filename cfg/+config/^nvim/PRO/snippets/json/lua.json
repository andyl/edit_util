{
  "xlocal": {
    "prefix": "xlocal",
    "body": [
      "local ${1:x} = ${0:1}"
    ]
  },
  "xfun": {
    "prefix": "xfun",
    "body": [
      "function ${1:fname}(${2:...})",
      "\t$0",
      "end"
    ]
  },
  "xfor": {
    "prefix": "xfor",
    "body": [
      "for ${1:i}=${2:1},${3:10} do",
      "\t${0:print(i)}",
      "end"
    ]
  },
  "xforp": {
    "prefix": "xforp",
    "body": [
      "for ${1:i},${2:v} in pairs(${3:table_name}) do",
      "\t$0",
      "end"
    ]
  },
  "xfori": {
    "prefix": "xfori",
    "body": [
      "for ${1:i},${2:v} in ipairs(${3:table_name}) do",
      "\t$0",
      "end"
    ]
  },
  "xif": {
    "prefix": "xif",
    "body": [
      "if $1 then",
      "\t$2",
      "end"
    ]
  },
  "xife": {
    "prefix": "xife",
    "body": [
      "if $1 then",
      "\t${2:-- if condition}",
      "else",
      "\t${0:-- else}",
      "end"
    ]
  },
  "xelif": {
    "prefix": "xelif",
    "body": [
      "elseif $1 then",
      "\t$0"
    ]
  },
  "xrepeat": {
    "prefix": "xrepeat",
    "body": [
      "repeat",
      "\t$1",
      "until $0"
    ]
  },
  "xwhile": {
    "prefix": "xwhile",
    "body": [
      "while $1 do",
      "\t$0",
      "end"
    ]
  },
  "xwh": {
    "prefix": "xwh",
    "body": [
      "while ${1:true} do",
      "\t${0}",
      "end"
    ]
  },
  "xwht": {
    "prefix": "xwht",
    "body": [
      "while true do",
      "\t${0}",
      "end"
    ]
  },
  "xprint": {
    "prefix": "xprint",
    "body": [
      "print(\"${1:string}\")"
    ]
  },
  "xpr": {
    "prefix": "xpr",
    "body": [
      "print($0)"
    ]
  },
  "xprs": {
    "prefix": "xprs",
    "body": [
      "print(\"$0\")"
    ]
  },
  "xprf": {
    "prefix": "xprf",
    "body": [
      "print(string.format(\"${1:%s}\"$0))"
    ]
  },
  "xwr": {
    "prefix": "xwr",
    "body": [
      "io.write($0)"
    ]
  },
  "xwrs": {
    "prefix": "xwrs",
    "body": [
      "io.write(\"$0\")"
    ]
  },
  "xwrf": {
    "prefix": "xwrf",
    "body": [
      "io.write(string.format(\"${1:%s}\"$0))"
    ]
  },
  "xfwr": {
    "prefix": "xfwr",
    "body": [
      "io.${1:stderr}:write($0)"
    ]
  },
  "xfwrs": {
    "prefix": "xfwrs",
    "body": [
      "io.${1:stderr}:write(\"$0\")"
    ]
  },
  "xfwrf": {
    "prefix": "xfwrf",
    "body": [
      "io.${1:stderr}:write(string.format(\"${2:%s}\"$0))"
    ]
  },
  "xim": {
    "prefix": "xim",
    "body": [
      "import \"${1:import file}\""
    ],
    "description": "Import File"
  }
}
