      "  ${1:key_name}: ${2:value}",
      "}"
    ]
  },
  "enfk": {
    "prefix": "enfk",
    "body": [
      "@enforce_keys [:${1:key_name}]"
    ]
  },
  "dfp": {
    "prefix": "dfp",
    "body": [
      "defp ${1:name}, do: ${2}"
    ]
  },
  "dfpw": {
    "prefix": "dfpw",
    "body": [
      "defp ${1:name}(${2:args}) when ${3:guard}, do: ${4}"
    ]
  },
  "defp": {
    "prefix": "defp",
    "body": [
      "defp ${1:name} do",
      "\t${0}",
      "end"
    ]
  },
  "defpw": {
    "prefix": "defpw",
    "body": [
      "defp ${1:name}(${2:args}) when ${3:guard} do",
      "\t${0}",
      "end"
    ]
  },
  "defpr": {
    "prefix": "defpr",
    "body": [
      "defprotocol ${1:name}, [${0:function}]"
    ]
  },
  "defr": {
    "prefix": "defr",
    "body": [
      "defrecord ${1:record_name}, ${0:fields}"
    ]
  },
  "doc": {
    "prefix": "doc",
    "body": [
      "@doc \"\"\"",
      "${0}",
      "\"\"\""
    ]
  },
  "docs": {
    "prefix": "docs",
    "body": [
      "@doc ~S\"\"\"",
      "${0}",
      "\"\"\""
    ]
  },
  "docf": {
    "prefix": "docf",
    "body": [
      "@doc false"
    ]
  },
  "im": {
    "prefix": "im",
    "body": [
      "@impl true"
    ]
  },
  "fn": {
    "prefix": "fn",
    "body": [
      "fn ${1:args} -> ${0} end"
    ]
  },
  "mdoc": {
    "prefix": "mdoc",
    "body": [
      "@moduledoc \"\"\"",
      "${0}",
      "\"\"\""
    ]
  },
  "mdocs": {
    "prefix": "mdocs",
    "body": [
      "@moduledoc ~S\"\"\"",
      "${0}",
      "\"\"\""
    ]
  },
  "mdocf": {
    "prefix": "mdocf",
    "body": [
      "@moduledoc false"
    ]
  },
  "rec": {
    "prefix": "rec",
    "body": [
      "receive do",
      "\t${1} ->",
      "\t\t${0}",
      "end"
    ]
  },
  "req": {
    "prefix": "req",
    "body": [
      "require ${0:Logger}"
    ]
  },
  "imp": {
    "prefix": "imp",
    "body": [
      "import ${0:module_name}"
    ]
  },
  "ali": {
    "prefix": "ali",
    "body": [
      "alias ${0:module_name}"
    ]
  },
  "test": {
    "prefix": "test",
    "body": [
      "test \"${1:test name}\" do",
      "\t${0}",
      "end"
    ]
  },
  "testc": {
    "prefix": "testc",
    "body": [
      "test \"${1:test_name}\", ctx do",
      "\t${0}",
      "end"
    ]
  },
  "testa": {
    "prefix": "testa",
    "body": [
      "test \"${1:test_name}\", %{${2:arg: arg}} do",
      "\t${0}",
      "end"
    ]
  },
  "desc": {
    "prefix": "desc",
    "body": [
      "describe \"${1:test group subject}\" do",
      "\t${0}",
      "end"
    ]
  },
  "destag": {
    "prefix": "destag",
    "body": [
      "@describetag :${1:describe tag}"
    ]
  },
  "mtag": {
    "prefix": "mtag",
    "body": [
      "@moduletag :${1:module tag}"
    ]
  },
  "dt": {
    "prefix": "dt",
    "body": [
      "doctest ${1:filename}"
    ]
  },
  "tp": {
    "prefix": "tp",
    "body": [
      "@tag :pending"
    ]
  },
  "exunit": {
    "prefix": "exunit",
    "body": [
      "defmodule ${1:`substitute(vim_snippets#Filename(), '\\(_\\|^\\)\\(.\\)', '\\u\\2', 'g')`} do",
      "\tuse ExUnit.Case, async: true",
      "\t${0}",
      "end"
    ]
  },
  "setup": {
    "prefix": "setup",
    "body": [
      "setup do",
      "\t${1}",
      "end"
    ]
  },
  "setupa": {
    "prefix": "setupa",
    "body": [
      "setup_all do",
      "\t${1}",
      "end",
      "try do",
      "\t${1:${VISUAL}}",
      "rescue",
      "\t${2} -> ${0}",
      "end"
    ]
  },
  "pry": {
    "prefix": "pry",
    "body": [
      "require IEx; IEx.pry",
      "${0}"
    ]
  },
  "ppry": {
    "prefix": "ppry",
    "body": [
      "|> (fn x -> require IEx; IEx.pry; x end).()${0}"
    ]
  },
  "qu": {
    "prefix": "qu",
    "body": [
      "quote do",
      "\t${1}",
      "end"
    ]
  },
  "beh": {
    "prefix": "beh",
    "body": [
      "@behaviour ${1:Mix.Task}",
      "${0}"
    ]
  },
  "p": {
    "prefix": "p",
    "body": [
      "|> ${0}",
      "|> Enum.each(fn ${1} -> ${0} end)",
      "|> Enum.map(fn ${1} -> ${0} end)",
      "|> Enum.filter(fn ${1} -> ${0} end)",
      "|> Enum.reduce(${1:acc}, fn ${2}, ${3:acc} -> ${0} end)",
      "|> IO.inspect",
      "|> IO.inspect(label: \"${1:label}\")"
    ]
  },
  "cs": {
    "prefix": "cs",
    "body": [
      "@doc false",
      "def child_spec(${1:_opts}) do",
      "\t%{",
      "\t\tid: __MODULE__,",
      "\t\tstart: {__MODULE__, :start_link, ${2:[]}},",
      "\t\trestart: ${3::permanent},",
      "\t\tshutdown: ${4:5000},",
      "\t\ttype: ${5::worker}",
      "\t}",
      "end"
    ]
  },
  "genserver": {
    "prefix": "genserver",
    "body": [
      "use GenServer",
      "@doc false",
      "def start_link do",
      "\tGenServer.start_link(__MODULE__, ${1:Map.new})",
      "end",
      "@impl true",
      "def init(state) do",
      "\t{:ok, state}",
      "end"
    ],
    "description": "basic genserver structure"
  },
  "genserver:": {
    "prefix": "genserver:",
    "body": [
      "use GenServer",
      "@doc false",
      "def start_link, do: GenServer.start_link(__MODULE__, ${1:Map.new})",
      "@impl true",
      "def init(state), do: {:ok, state}"
    ],
    "description": "basic genserver structure"
  },
  "impl": {
    "prefix": "impl",
    "body": [
      "@impl true",
      "def ${1:name} do",
      "\t${0}",
      "end"
    ]
  },
  "wl": {
    "prefix": "wl",
    "body": [
      "~w(${0})",
      "~w(${0})a"
    ],
    "description": "word list"
  }
}
