{
  "do": {
    "prefix": "do",
    "body": [
      "do",
      "  ${0:${VISUAL}}",
      "end"
    ],
    "description": "Insert a do block"
  },
  "puts": {
    "prefix": "puts",
    "body": [
      "IO.puts(\"${0}\")"
    ],
    "description": "IO.puts"
  },
  "ins": {
    "prefix": "ins",
    "body": [
      "IO.inspect(${0})"
    ],
    "description": "IO.inspect"
  },
  "insl": {
    "prefix": "insl",
    "body": [
      "IO.inspect(${1}label: \"${2:label}\")${0}"
    ],
    "description": "IO.inspect with label"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1} do",
      "  ${0:${VISUAL}}",
      "end"
    ],
    "description": "if .. do .. end"
  },
  "if:": {
    "prefix": "if:",
    "body": [
      "if ${1:condition}, do: ${0}"
    ],
    "description": "if .. do: .."
  },
  "ife": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} do",
      "  ${2:${VISUAL}}",
      "else",
      "  ${0}",
      "end"
    ],
    "description": "if .. do .. else .. end"
  },
  "ife:": {
    "prefix": "ife:",
    "body": [
      "if ${1:condition}, do: ${2}, else: ${0}"
    ],
    "description": "if .. do: .. else:"
  },
  "cond": {
    "prefix": "cond",
    "body": [
      "cond do",
      "  ${1} ->",
      "  ${0:${VISUAL}}",
      "end"
    ]
  },
  "case": {
    "prefix": "case",
    "body": [
      "case ${1} do",
      "  ${2} ->",
      "    ${0}",
      "end"
    ]
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:item} <- ${2:items} do",
      "  ${0}",
      "end"
    ]
  },
  "for:": {
    "prefix": "for:",
    "body": [
      "for ${1:item} <- ${2:items}, do: ${0}"
    ]
  },
  "fori": {
    "prefix": "fori",
    "body": [
      "for ${1:item} <- ${2:items}, into: ${3} do",
      "  ${0}",
      "end"
    ]
  },
  "wi": {
    "prefix": "wi",
    "body": [
      "with ${1:item} <- ${2:items} do",
      "  ${0}",
      "end"
    ]
  },
  "wie": {
    "prefix": "wie",
    "body": [
      "with(",
      "  ${1:item} <- ${2:items}",
      ") do",
      "  ${3}",
      "else",
      "  ${4} ->",
      "    ${0}",
      "end"
    ]
  },
  "sp": {
    "prefix": "sp",
    "body": [
      "@spec ${1:name}(${2:args}) :: ${3:returns}"
    ]
  },
  "op": {
    "prefix": "op",
    "body": [
