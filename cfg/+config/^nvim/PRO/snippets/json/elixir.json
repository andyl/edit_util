{
  "xdo": {
    "prefix": "xdo",
    "body": [
      "do",
      "  ${0:${VISUAL}}",
      "end"
    ],
    "description": "Insert a do block"
  },
  "xputs": {
    "prefix": "xputs",
    "body": [
      "IO.puts(\"${0}\")"
    ],
    "description": "IO.puts"
  },
  "xins": {
    "prefix": "xins",
    "body": [
      "IO.inspect(${0})"
    ],
    "description": "IO.inspect"
  },
  "xinsl": {
    "prefix": "xinsl",
    "body": [
      "IO.inspect(${1}label: \"${2:label}\")${0}"
    ],
    "description": "IO.inspect with label"
  },
  "xif": {
    "prefix": "xif",
    "body": [
      "if ${1} do",
      "  ${0:${VISUAL}}",
      "end"
    ],
    "description": "if .. do .. end"
  },
  "xif:": {
    "prefix": "xif:",
    "body": [
      "if ${1:condition}, do: ${0}"
    ],
    "description": "if .. do: .."
  },
  "xife": {
    "prefix": "xife",
    "body": [
      "if ${1:condition} do",
      "  ${2:${VISUAL}}",
      "else",
      "  ${0}",
      "end"
    ],
    "description": "if .. do .. else .. end"
  },
  "xife:": {
    "prefix": "xife:",
    "body": [
      "if ${1:condition}, do: ${2}, else: ${0}"
    ],
    "description": "if .. do: .. else:"
  },
  "xcond": {
    "prefix": "xcond",
    "body": [
      "cond do",
      "  ${1} ->",
      "  ${0:${VISUAL}}",
      "end"
    ]
  },
  "xcase": {
    "prefix": "xcase",
    "body": [
      "case ${1} do",
      "  ${2} ->",
      "    ${0}",
      "end"
    ]
  },
  "xfor": {
    "prefix": "xfor",
    "body": [
      "for ${1:item} <- ${2:items} do",
      "  ${0}",
      "end"
    ]
  },
  "xfor:": {
    "prefix": "xfor:",
    "body": [
      "for ${1:item} <- ${2:items}, do: ${0}"
    ]
  },
  "xfori": {
    "prefix": "xfori",
    "body": [
      "for ${1:item} <- ${2:items}, into: ${3} do",
      "  ${0}",
      "end"
    ]
  },
  "xwi": {
    "prefix": "xwi",
    "body": [
