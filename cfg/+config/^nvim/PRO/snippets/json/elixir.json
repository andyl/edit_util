    ]
  },
  "ty": {
    "prefix": "ty",
    "body": [
      "@type ${1:type_name} :: ${2:type}"
    ]
  },
  "typ": {
    "prefix": "typ",
    "body": [
      "@typep ${1:type_name} :: ${2:type}"
    ]
  },
  "cb": {
    "prefix": "cb",
    "body": [
      "@callback ${1:name}(${2:args}) :: ${3:returns}"
    ]
  },
  "df": {
    "prefix": "df",
    "body": [

    ]
  },
  "dfw": {
    "prefix": "dfw",
    "body": [
      "def ${1:name}(${2:args}) when ${3:guard}, do:"
    ]
  },
  "def": {
    "prefix": "def",
    "body": [

    ],
    "description": "Public function"
  },
  "defd": {
    "prefix": "defd",
    "body": [
      "@doc \"\"\"",
      "${1:doc string}",
      "\"\"\"",
      "def ${2:name} do",
      "  ${0}",
      "end"
    ]
  },
  "defs": {
    "prefix": "defs",
    "body": [
      "@spec ${1:name}(${2:arg types}) :: ${3:no_return}",
      "def $1(${4:args}) do",
      "  ${0}",
      "end"
    ]
  },
  "defsd": {
    "prefix": "defsd",
    "body": [
      "@doc \"\"\"",
      "${1:doc string}",
      "\"\"\"",
      "@spec ${2:name}(${3:arg types}) :: ${4:no_return}",
      "def $2(${5:args}) do",
      "  ${0}",
      "end"
    ]
  },
  "defw": {
    "prefix": "defw",
    "body": [
      "def ${1:name}(${2:args}) when ${3:guard} do",
      "  ${0}",
      "end"
    ]
  },
  "defim": {
    "prefix": "defim",
    "body": [
      "defimpl ${1:protocol_name}, for: ${2:data_type} do",
      "  ${0}",
      "end"
    ]
  },
  "defma": {
    "prefix": "defma",
    "body": [
      "defmacro ${1:name} do",
      "  ${0}",
      "end"
    ]
  },
  "defmo": {
    "prefix": "defmo",
    "body": [
      "defmodule ${1:`substitute(vim_snippets#Filename(), '\\(_\\|^\\)\\(.\\)', '\\u\\2', 'g')`} do",
      "  ${0}",
      "end"
    ]
  },
  "%M": {
    "prefix": "%M",
    "body": [
