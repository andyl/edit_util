    "prefix": "xexunit",
    "body": [
      "defmodule ${1:`substitute(vim_snippets#Filename(), '\\(_\\|^\\)\\(.\\)', '\\u\\2', 'g')`} do",
      "\tuse ExUnit.Case, async: true",
      "\t${0}",
      "end"
    ]
  },
  "xsetup": {
    "prefix": "xsetup",
    "body": [
      "setup do",
      "\t${1}",
      "end"
    ]
  },
  "xsetupa": {
    "prefix": "xsetupa",
    "body": [
      "setup_all do",
      "\t${1}",
      "end",
      "try do",
      "\t${1:${VISUAL}}",
      "rescue",
      "\t${2} -> ${0}",
      "end"
    ]
  },
  "xpry": {
    "prefix": "xpry",
    "body": [
      "require IEx; IEx.pry",
      "${0}"
    ]
  },
  "xppry": {
    "prefix": "xppry",
    "body": [
      "|> (fn x -> require IEx; IEx.pry; x end).()${0}"
    ]
  },
  "xqu": {
    "prefix": "xqu",
    "body": [
      "quote do",
      "\t${1}",
      "end"
    ]
  },
  "xbeh": {
    "prefix": "xbeh",
    "body": [
      "@behaviour ${1:Mix.Task}",
      "${0}"
    ]
  },
  "xp": {
    "prefix": "xp",
    "body": [
      "|> ${0}",
      "|> Enum.each(fn ${1} -> ${0} end)",
      "|> Enum.map(fn ${1} -> ${0} end)",
      "|> Enum.filter(fn ${1} -> ${0} end)",
      "|> Enum.reduce(${1:acc}, fn ${2}, ${3:acc} -> ${0} end)",
      "|> IO.inspect",
      "|> IO.inspect(label: \"${1:label}\")"
    ]
  },
  "xcs": {
    "prefix": "xcs",
    "body": [
      "@doc false",
      "def child_spec(${1:_opts}) do",
      "\t%{",
      "\t\tid: __MODULE__,",
      "\t\tstart: {__MODULE__, :start_link, ${2:[]}},",
      "\t\trestart: ${3::permanent},",
      "\t\tshutdown: ${4:5000},",
      "\t\ttype: ${5::worker}",
      "\t}",
      "end"
    ]
  },
  "xgenserver": {
    "prefix": "xgenserver",
    "body": [
      "use GenServer",
      "@doc false",
      "def start_link do",
      "\tGenServer.start_link(__MODULE__, ${1:Map.new})",
      "end",
      "@impl true",
      "def init(state) do",
      "\t{:ok, state}",
      "end"
    ],
    "description": "basic genserver structure"
  },
  "xgenserver:": {
    "prefix": "xgenserver:",
    "body": [
      "use GenServer",
      "@doc false",
      "def start_link, do: GenServer.start_link(__MODULE__, ${1:Map.new})",
      "@impl true",
      "def init(state), do: {:ok, state}"
    ],
    "description": "basic genserver structure"
  },
  "ximpl": {
    "prefix": "ximpl",
    "body": [
