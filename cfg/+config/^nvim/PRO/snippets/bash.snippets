# Bash Snippets 

snippet bash "Shebang line"
	#!/usr/bin/env bash

snippet s! "Shebang line"
	#!/usr/bin/env bash
	set -eu

snippet if "If statement"
	if [[ $1 ]]; then
		${0:${VISUAL}}
	fi

snippet elif
	elif [[ $1 ]]; then
		${0:${VISUAL}}

snippet wh
	while [[ $1 ]]; do
		${0:${VISUAL}}
	done

snippet until
	until [[ $1 ]]; do
		${0:${VISUAL}}
	done
