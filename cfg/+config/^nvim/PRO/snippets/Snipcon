#!/usr/bin/env ruby

require 'json'

# Snipcon
# This script converts snipmate-formatted snippets 
# to VSCode formatted snippets (JSON).
#
# Usage: Snipcon <snippet file>

# --- Leader Char --- 

leader_char = "x"

# --- Helper Functions ---

# Adds the currently parsed snippet data to the main hash
def add_current_snippet_to_hash(snippets_data, key, body, description)
  return unless key # Do nothing if no key is set

  snippet_entry = {
    "prefix" => key,
    "body" => body
  }
  # Only add the description key if a description was provided
  snippet_entry["description"] = description if description

  snippets_data[key] = snippet_entry
end

# --- Main Script ---

# Check if a command-line argument is provided
if ARGV.length != 1
  puts "Usage: #{File.basename($PROGRAM_NAME)} <path_to_snippet_file>"
  exit(1)
end

snippet_file_path = ARGV[0]

# Check if the provided file exists
unless File.exist?(snippet_file_path)
  puts "Error: Snippet file not found at '#{snippet_file_path}'"
  exit(1)
end

# --- Snippet Conversion ---

# Initialize data structures
snippets_data = {}
current_snippet_key = nil
current_snippet_body = []
current_snippet_description = ""

# Process the snippet file line by line
File.foreach(snippet_file_path).with_index do |line, index|
  # Preserve original line for body processing, strip for some checks
  line_stripped = line.strip

  # Skip blank lines
  next if line_stripped.empty?

  # Check for snippet definition line
  if (match = line_stripped.match(/^snippet\s+(\S+)(?:\s+"(.*?)")?$/))
    # Add the previous snippet before starting a new one
    add_current_snippet_to_hash(snippets_data, current_snippet_key, current_snippet_body, current_snippet_description)

    # Start a new snippet
    current_snippet_key = leader_char + match[1]
    current_snippet_description = match[2] # Can be nil if no description
    current_snippet_body = []
  # Check for snippet body line (must start with a tab)
  elsif line.start_with?("\t") && current_snippet_key
    # Add body line (including those starting with \t#)
    # Remove the leading tab and trailing newline
    current_snippet_body << line[1..-1].chomp
  # Skip top-level comments (lines starting with # after leading whitespace)
  elsif line.lstrip.start_with?('#')
    next # Skip this line
  # Handle lines that are not blank, snippet defs, body lines, or top-level comments
  else
    # If we are inside a snippet definition, maybe warn? For now, ignore.
    # puts "Warning: Ignoring unexpected line #{index + 1}: #{line_stripped}"
  end
end

# Add the last snippet after the loop finishes
add_current_snippet_to_hash(snippets_data, current_snippet_key, current_snippet_body, current_snippet_description)

# Convert the hash to JSON and print it
puts JSON.pretty_generate(snippets_data)
